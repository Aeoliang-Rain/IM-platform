    "/v1/conversations": {
      "get": {
        "operationId": "listOwnConversationMembers",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Read-only bounded joined member rows for the authenticated user's effective conversations; both own membership and returned membership require left_at IS NULL. Each row includes existing minimal PublicUser (userId/username/displayName), including nonfriends; no credentials or arbitrary user lookup. No body or additional query keys. afterConversationId and afterMemberUserId are either both absent (start) or both canonical UUIDs. Sort strictly by UUID tuple (conversationId,member.user.userId) ascending, exclusive after tuple. Each query reads one committed consistent page plus at most one lookahead row. items <= limit (default100,max100); hasMore iff another eligible committed row exists, requires nonempty progress. When true next exactly equals last row tuple; when false both next strings empty. Empty page terminal. Continue every page to terminal with no fixed total row/page cap, merge by conversationId/member.userId and verify repeated conversation metadata is consistent within each page. A conversation can span pages. No group-size cap. Each page is current, not a frozen global snapshot: concurrent inserts below the last tuple can be absent from this scan. User Sync conversation/membership invalidation and periodic full rescan from start must refresh/upsert affected identities; do not discard an invalidation arriving during an unfinished scan or treat terminal as future writes synchronized. Authorization is rechecked for each page; a cursor tuple grants no access to its conversation or user. New writes become visible on later scans; retries are read-only and may observe newer committed data.",
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "./auth-user-friend.openapi.json#/components/schemas/Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          },
          {
            "name": "afterConversationId",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "./auth-user-friend.openapi.json#/components/schemas/Id"
            }
          },
          {
            "name": "afterMemberUserId",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "./auth-user-friend.openapi.json#/components/schemas/Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current own member page",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationPage"
                }
              }
            }
          },
          "400": {
            "description": "Canonical request or authentication rejection",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../errors/http-errors.schema.json#/$defs/ErrorResponse"
                }
              }
            },
            "x-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "401": {
            "description": "Canonical request or authentication rejection",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../errors/http-errors.schema.json#/$defs/ErrorResponse"
                }
              }
