      },
      "ConversationMemberView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conversationId",
          "kind",
          "createdBy",
          "createdAt",
          "member"
        ],
        "properties": {
          "conversationId": {
            "$ref": "./auth-user-friend.openapi.json#/components/schemas/Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "DIRECT",
              "GROUP"
            ]
          },
          "createdBy": {
            "$ref": "./auth-user-friend.openapi.json#/components/schemas/Id"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "member": {
            "$ref": "#/components/schemas/Member"
          }
        }
      },
      "Continuation": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "afterConversationId",
              "afterMemberUserId"
            ],
            "properties": {
              "afterConversationId": {
                "$ref": "./auth-user-friend.openapi.json#/components/schemas/Id"
              },
              "afterMemberUserId": {
                "$ref": "./auth-user-friend.openapi.json#/components/schemas/Id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "afterConversationId",
              "afterMemberUserId"
            ],
            "properties": {
              "afterConversationId": {
                "const": ""
              },
              "afterMemberUserId": {
                "const": ""
              }
            }
          }
        ]
      },
      "ConversationPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "items",
          "hasMore",
          "next"
        ],
        "properties": {
          "requestId": {
            "$ref": "./auth-user-friend.openapi.json#/components/schemas/Id"
          },
          "items": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ConversationMemberView"
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "next": {
            "$ref": "#/components/schemas/Continuation"
          }
        }
      }
    }
  },
