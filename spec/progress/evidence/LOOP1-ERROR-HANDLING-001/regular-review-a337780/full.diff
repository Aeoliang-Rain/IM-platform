+87: pub fn language_load(app:tauri::AppHandle)->String{match app.path().app_data_dir(){Ok(root)=>load_language(&root.join("language.txt")),Err(_)=>"en".into()}}
+88: #[tauri::command]
+89: pub fn language_save(app:tauri::AppHandle,value:String)->Result<(),String>{save_language(&app.path().app_data_dir().map_err(|_|"Language unavailable")?.join("language.txt"),&value)}
