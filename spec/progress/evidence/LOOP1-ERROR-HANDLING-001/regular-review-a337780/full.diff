+type syncUserEvent struct {
+	EventID   string      `json:"eventId"`
+	Cursor    string      `json:"cursor"`
+	Kind      string      `json:"kind"`
+	SubjectID string      `json:"subjectId"`
+	Revision  json.Number `json:"revision"`
+}
