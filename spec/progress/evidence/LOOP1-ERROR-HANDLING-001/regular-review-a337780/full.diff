diff --git a/spec/progress/evidence/LOOP1-ERROR-HANDLING-001/fix-appearance-read/appearance_native_reads.mjs b/spec/progress/evidence/LOOP1-ERROR-HANDLING-001/fix-appearance-read/appearance_native_reads.mjs
