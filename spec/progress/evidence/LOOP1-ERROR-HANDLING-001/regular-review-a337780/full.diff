+6: pub async fn open(root: PathBuf, account: &str) -> Result<SqliteConnection, String> {
+7:     // UUID filenames prevent directory traversal/aliases and keep accounts apart.
+8:     if account.len() != 36 || !account.chars().enumerate().all(|(i,c)|
+9:         if [8,13,18,23].contains(&i) { c=='-' } else { c.is_ascii_hexdigit() }) {
+10:         return Err("Invalid account identity".into());
+11:     }
+12:     std::fs::create_dir_all(&root).map_err(|_| "Storage directory unavailable")?;
+13:     let options = SqliteConnectOptions::new()
+14:         .filename(root.join(format!("im-{}.sqlite",account.to_ascii_lowercase())))
+15:         .create_if_missing(true).busy_timeout(Duration::from_secs(5));
+16:     SqliteConnection::connect_with(&options).await.map_err(|_| "Storage open failed".into())
+17: }
+18: pub async fn open_read_only(root: PathBuf, account: &str) -> Result<SqliteConnection, String> {
+19:     // Ensure the account's empty file can exist before its first migration,
+20:     // then reopen physically read-only: even caller PRAGMAs cannot enable writes.
+21:     open(root.clone(), account).await?.close().await.map_err(|_| "Storage close failed")?;
+22:     let options = SqliteConnectOptions::new()
+23:         .filename(root.join(format!("im-{}.sqlite", account.to_ascii_lowercase())))
+24:         .read_only(true).busy_timeout(Duration::from_secs(5));
+25:     SqliteConnection::connect_with(&options).await.map_err(|_| "Storage read open failed".into())
+26: }
+27: pub async fn transaction(connection: &mut SqliteConnection, statements: Vec<Statement>) -> Result<(), String> {
