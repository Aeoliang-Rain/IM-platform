+95:     let menu=tauri::menu::Menu::with_items(app,&[&open,&hide,&quit])?;
+96:     app.manage(TrayPresentation{open,hide,quit});
+97:     let icon=app.default_window_icon().ok_or("Application icon unavailable")?.clone();
+98:     tauri::tray::TrayIconBuilder::with_id("im-plus").icon(icon).tooltip("IM+ · Your workspace").menu(&menu).on_menu_event(|app,event|match event.id.as_ref(){"open"=>show(app),"hide"=>{if let Some(w)=app.get_webview_window("main"){w.hide().expect("Window hide failed");}},"quit"=>app.exit(0),_=>{}}).build(app)?;
