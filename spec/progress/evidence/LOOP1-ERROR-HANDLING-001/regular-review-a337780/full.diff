+72: fn valid_language(value:&str)->bool{matches!(value,"en"|"zh-CN"|"ja-JP")}
+73: fn load_language(path:&std::path::Path)->String {
+74:     use std::io::Read;
+75:     // At most six bytes read: an overlong file is invalid without unbounded allocation.
+76:     let mut bytes=Vec::new();
+77:     let result=std::fs::File::open(path).and_then(|file|file.take(6).read_to_end(&mut bytes));
+78:     if result.is_err()||bytes.len()>5{return "en".into();}
+79:     match std::str::from_utf8(&bytes){Ok(value) if valid_language(value)=>value.into(),_=>"en".into()}
+80: }
+81: fn save_language(path:&std::path::Path,value:&str)->Result<(),String>{
+82:     if !valid_language(value){return Err("Language invalid".into());}
+83:     std::fs::create_dir_all(path.parent().ok_or("Language unavailable")?).map_err(|_|"Language unavailable")?;
+84:     std::fs::write(path,value.as_bytes()).map_err(|_|"Language unavailable".into())
+85: }
