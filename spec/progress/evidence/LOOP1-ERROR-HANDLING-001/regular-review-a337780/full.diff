+func (s *authService) socialPrincipal(r *http.Request) (claims, error) {
+	token, err := bearer(r)
+	if err != nil {
+		return claims{}, fail(401, "AUTH_REQUIRED", "Authentication is required.")
+	}
+	return s.authenticate(r.Context(), token)
+}
