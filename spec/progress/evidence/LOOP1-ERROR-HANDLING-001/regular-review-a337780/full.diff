+FILE clients/web/src/ui/i18n/resources.ts
+import en from "./en.js";
+import zhCN from "./zh-CN.js";
+import jaJP from "./ja-JP.js";
+export type Locale="en"|"zh-CN"|"ja-JP";
+export const locales:readonly Locale[]=["en","zh-CN","ja-JP"];
+export const languageNames=["English","简体中文","日本語"] as const;
+export const languageEntry="Language / 语言 / 言語";
+export function validLocale(value:unknown):value is Locale{return value==="en"||value==="zh-CN"||value==="ja-JP";}
+export const resources:Record<Locale,Record<string,string>>={en,"zh-CN":zhCN,"ja-JP":jaJP};
+// Display-only lookup. Wire values, user text and stable application IDs never pass through this function.
+export function translate(locale:unknown,key:string,params:Record<string,string|number>={},data=resources):string {
+ const language=validLocale(locale)?locale:"en";
+ if(!Object.hasOwn(data.en,key))throw new Error("Missing English language key: "+key);
+ const table=data[language];
+ const template=table&&Object.hasOwn(table,key)?table[key]:data.en[key];
+ if(template===undefined)throw new Error("Missing English language key: "+key);
+ return template.replace(/\{([A-Za-z]+)\}/g,(_,name:string)=>String(params[name]??"{"+name+"}"));
+}
