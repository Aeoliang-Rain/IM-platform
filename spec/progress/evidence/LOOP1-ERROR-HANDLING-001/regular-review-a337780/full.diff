+64: pub fn tray_text(app:tauri::AppHandle,open:String,hide:String,quit:String,tooltip:String)->Result<(),String>{
+65:     if [&open,&hide,&quit,&tooltip].iter().any(|value|value.is_empty()||value.chars().count()>80||value.contains(['\r','\n'])){return Err("Tray text invalid".into());}
